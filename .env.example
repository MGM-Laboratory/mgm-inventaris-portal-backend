# The environment the service runs in, development or production
ENVIRONMENT=production
# The Secure flag of the session cookie. It comes from this setting and never from the request. Only development may set it to false.
SECURE_COOKIE=true
# The log level, debug, info, warn or error
LOG_LEVEL=info

# The address of the API, and the address of the health routes that the proxy does not route
HTTP_ADDR=:8080
HEALTH_ADDR=127.0.0.1:8081

# The PostgreSQL connection URL. It holds the password, so it stays in this file only.
DATABASE_URL=postgres://portal:change-me@127.0.0.1:5432/portal?sslmode=disable
# The size of the pool of one copy. Two copies share one database, so keep the sum below its connection limit.
DB_MAX_CONNS=8
# Apply the embedded migrations at start, under an advisory lock
MIGRATE_ON_START=true

# The public address of the portal, with the scheme and the host only. The QR address of a unit is this value, /aset/ and the tag.
PUBLIC_BASE_URL=https://portal.example.org
# The address of the reverse proxy. The service reads X-Real-IP only from a request that comes from it. Empty trusts no header.
TRUSTED_PROXY=

# The limits of the lab, also shown by GET /api/config
MAX_ITEMS_PER_REQUEST=10
MAX_DURATION_DAYS=30
MAX_OPEN_TICKETS=3
