# The environment the service runs in, development or production
ENVIRONMENT=production
# The Secure flag of the session cookie. It comes from this setting and never from the request. Only development may set it to false.
SECURE_COOKIE=true
# The log level, debug, info, warn or error
LOG_LEVEL=info

# The address of the API, and the address of the health routes that the proxy does not route
HTTP_ADDR=:8080
HEALTH_ADDR=127.0.0.1:8081

# The PostgreSQL connection URL. It holds the password, so it stays in this file only.
DATABASE_URL=postgres://portal:change-me@127.0.0.1:5432/portal?sslmode=disable
# The size of the pool of one copy. Two copies share one database, so keep the sum below its connection limit.
DB_MAX_CONNS=8
# Apply the embedded migrations at start, under an advisory lock
MIGRATE_ON_START=true

# The public address of the portal, with the scheme and the host only. The QR address of a unit is this value, /aset/ and the tag.
PUBLIC_BASE_URL=https://portal.example.org
# A comma separated list of IP addresses and CIDR ranges of the reverse proxy. The service reads X-Real-IP only from a request whose
# peer is in the list. Behind a published Docker port the peer is the gateway of the bridge, so name its range. Empty trusts no header.
TRUSTED_PROXIES=

# The limits of the lab, also shown by GET /api/config
MAX_ITEMS_PER_REQUEST=10
MAX_DURATION_DAYS=30
MAX_OPEN_TICKETS=3
# The most guest sign in requests that one client address may send in an hour, from 1 to 100000. Every request counts.
GUEST_SIGNIN_PER_HOUR=60
# The most ticket requests that one client address may send in an hour, from 1 to 100000. Every request counts.
TICKET_CREATE_PER_HOUR=20
# The most failed ticket lookups in an hour for one client address, from 1 to 1000. A found ticket does not count.
TICKET_LOOKUP_ADDRESS_FAILURES=20
# The most failed ticket lookups in an hour for one ticket number without its last four characters together with one email, from 1 to
# 1000. A found ticket does not count.
TICKET_LOOKUP_NUMBER_FAILURES=10

# The most failed admin sign ins in 15 minutes for one email from one client address, from 1 to 1000. The next request of that pair
# answers 429 until the window ends. A success never resets the count.
ADMIN_SIGNIN_PAIR_FAILURES=5
# The most failed admin sign ins in an hour for one client address, whatever the email, from 1 to 1000
ADMIN_SIGNIN_ADDRESS_FAILURES=20
# The most failed password or code checks in 15 minutes on the account routes of one admin session, from 1 to 1000
ADMIN_ACCOUNT_FAILURES=5
# The most Argon2id hashes that run at once in one copy, from 1 to 16. One hash needs about 19 MiB of memory.
PASSWORD_HASH_CONCURRENCY=2

# The key that seals the TOTP secret of every admin, 32 random bytes in Base64. Make one with openssl rand -base64 32 and keep a copy
# apart from the database, because a lost key makes every stored TOTP secret unreadable. The value below is a placeholder that the
# service refuses.
TOTP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
