# The settings of the docs site example, copied to the server as .env next to compose.yml. Compose reads this file for its own
# variables (the port, the image tag and the limits), and the container loads none of it. See docs/deployment.md.

# The tag of the image that runs, as 1.2.3 without the v, or as a tag of a commit such as sha-1a2b3c4 until the first release. Set it
# by hand for the first start and on every update. A value of latest works but gives no way back, so name a version or a commit tag.
DOCS_IMAGE_TAG=
# The registry and the name of the image. The default is GitHub Container Registry. To pull from the Docker Hub mirror, set the
# name to <namespace>/mgm-inventaris-portal-docs.
# DOCS_IMAGE=ghcr.io/mgm-laboratory/mgm-inventaris-portal-docs

# The address that the port of the copy listens on. The default is the loopback address, so only a proxy on the same host reaches it.
# A proxy on another host, for example over a private network, needs the address of that network interface here.
DOCS_BIND=127.0.0.1
# Required, with no default. The host port of the copy. Pick a port that is free on the host. The container port is fixed at 8080.
DOCS_PORT=

# Limits of the copy, and the size of the log files that Docker keeps for it.
DOCS_CPUS=0.50
DOCS_MEMORY_LIMIT=32m
DOCS_STOP_GRACE_PERIOD=20s
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
